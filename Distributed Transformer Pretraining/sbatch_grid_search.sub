#!/bin/bash
#SBATCH --job-name=grid_search
#SBATCH --nodes=2
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-gpu=8
#SBATCH --partition=plgrid-gpu-a100
#SBATCH --mem=125G
#SBATCH --account=plgpkattenion-gpu-a100
#SBATCH --time=0-01:00:00
#SBATCH --output=slurm-%A_%a.out
#SBATCH --array=0-2  # 3 learning rates

LEARNING_RATES=(0.01 0.001 0.0001)
LR=${LEARNING_RATES[$SLURM_ARRAY_TASK_ID]}

NUM_LAYERS=4
D_MODEL=256
NUM_HEADS=4
BATCH_SIZE=256
TRAIN_STEPS=4576
SEQ_LENGTH=256
DROPOUT=0.0

# Multi-node setup
MASTER_ADDR=$(srun --nodes=1 --ntasks=1 hostname -i)
MASTER_PORT=$(expr 29500 + $(echo -n $SLURM_JOB_ID | tail -c 4))

# export MASTER_ADDR=$(hostname -I | awk '{print $1}')
# export MASTER_PORT=$(expr 29500 + $(echo -n $SLURM_JOB_ID | tail -c 4))

echo "===== SLURM DEBUG ====="
echo "SLURM Job ID: $SLURM_JOB_ID"
echo "Array Task ID: $SLURM_ARRAY_TASK_ID"
echo "Selected LR: $LR"
echo "Nodes allocated: $SLURM_JOB_NODELIST"
echo "Master address: $MASTER_ADDR"
echo "Master port: $MASTER_PORT"
echo "Hostname: $(hostname)"
echo "Number of GPUs visible: $(nvidia-smi --list-gpus | wc -l)"
echo "======================="

source /net/tscratch/people/plggabkic/bmlvenv/bin/activate

srun torchrun \
    --nproc_per_node=1 \
    --nnodes=2 \
    --rdzv_id=$SLURM_JOB_ID \
    --rdzv_backend=c10d \
    --rdzv_endpoint=$MASTER_ADDR:$MASTER_PORT \
  main.py --lr $LR \
  --num_layers $NUM_LAYERS \
  --d_model $D_MODEL \
  --num_heads $NUM_HEADS \
  --batch_size $BATCH_SIZE \
  --seq_length $SEQ_LENGTH \
  --dropout $DROPOUT \
  --train_steps $TRAIN_STEPS \

